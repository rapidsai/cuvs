#include <core/cub_ptx_query.hpp>
#include <core/random_launchers.hpp>
#include <raft/random/permute.cuh>

namespace cuvs::detail::random {

template <typename T, typename Index>
void permute(Index* indices, Index columns, Index rows, cudaStream_t stream)
{
  raft::random::permute<T, Index, Index>(indices, nullptr, nullptr, columns, rows, true, stream);
}

@primitive_instantiations@

}  // namespace cuvs::detail::random
