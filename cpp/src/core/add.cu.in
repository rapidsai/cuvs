#include <core/map_launchers.hpp>

#include <cuvs/core/cuda_fp16.hpp>
#include <raft/linalg/add.cuh>

namespace cuvs::detail {

template <typename InT, typename OutT, typename IdxType>
void add(OutT* out, const InT* in1, const InT* in2, IdxType len, cudaStream_t stream)

{
  return raft::linalg::add(out, in1, in2, len, stream);
}

template <typename InType, typename OutType, typename, typename>
void add(raft::resources const& handle, InType in1, InType in2, OutType out)

{
  return raft::linalg::add(handle, in1, in2, out);
}

}  // namespace cuvs::detail

@primitive_instantiations@
