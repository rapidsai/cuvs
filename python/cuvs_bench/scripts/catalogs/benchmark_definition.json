{
  "benchmark_definition_name": "cuvs-bench-fashion-mnist-784-euclidean-k10-bs1",
  "scale_factor": 1,
  "total_queries": 4,
  "metrics": [
    {
      "key": "runtime",
      "display_name": "Search Latency",
      "description": "Wall-clock latency for one query batch.",
      "value_type": "number",
      "unit": "ms",
      "direction": "lower",
      "default_aggregation": "mean",
      "minimum": 0
    },
    {
      "key": "recall",
      "display_name": "Recall",
      "description": "Fraction of returned neighbors matching ground truth.",
      "value_type": "number",
      "direction": "higher",
      "default_aggregation": "mean",
      "minimum": 0,
      "maximum": 1
    },
    {
      "key": "throughput",
      "display_name": "Throughput",
      "description": "Queries per second.",
      "value_type": "number",
      "unit": "queries/s",
      "direction": "higher",
      "default_aggregation": "mean",
      "minimum": 0
    },
    {
      "key": "build_time",
      "display_name": "Index Build Time",
      "description": "Wall-clock time to build the index this query was searched against.",
      "value_type": "number",
      "unit": "s",
      "direction": "lower",
      "default_aggregation": "mean",
      "minimum": 0
    },
    {
      "key": "index_size",
      "display_name": "Index Size",
      "description": "Number of vectors used to train the index.",
      "value_type": "integer",
      "unit": "vectors",
      "direction": "neutral",
      "default_aggregation": "none",
      "minimum": 0
    },

    {
      "key": "nlist",
      "display_name": "nlist",
      "description": "Number of inverted lists. Shared by IVF-PQ and IVF-Flat.",
      "value_type": "integer",
      "direction": "neutral",
      "default_aggregation": "none"
    },
    {
      "key": "nprobe",
      "display_name": "nprobe",
      "description": "Number of lists probed at search time. Shared by IVF-PQ and IVF-Flat.",
      "value_type": "integer",
      "direction": "neutral",
      "default_aggregation": "none"
    },
    {
      "key": "ratio",
      "display_name": "ratio",
      "description": "Training set subsampling ratio. Shared by IVF-PQ and IVF-Flat.",
      "value_type": "integer",
      "direction": "neutral",
      "default_aggregation": "none"
    },
    {
      "key": "niter",
      "display_name": "niter",
      "description": "k-means iterations during build. Shared by IVF-PQ and IVF-Flat.",
      "value_type": "integer",
      "direction": "neutral",
      "default_aggregation": "none"
    }
  ],
  "query_logs": [
    {
      "query_name": "cuvs_cagra",
      "extra_info": {"algorithm": "CAGRA", "index_type": "graph"},
      "metrics": [
        {"key": "graph_degree", "display_name": "graph_degree", "value_type": "integer", "default_aggregation": "none"},
        {"key": "intermediate_graph_degree", "display_name": "intermediate_graph_degree", "value_type": "integer", "default_aggregation": "none"},
        {"key": "graph_build_algo", "display_name": "graph_build_algo", "value_type": "string"},
        {"key": "itopk", "display_name": "itopk", "value_type": "integer", "default_aggregation": "none"},
        {"key": "search_width", "display_name": "search_width", "value_type": "integer", "default_aggregation": "none"}
      ]
    },
    {
      "query_name": "cuvs_ivf_pq",
      "extra_info": {"algorithm": "IVF-PQ", "index_type": "ivf"},
      "metrics": [
        {"key": "pq_dim", "display_name": "pq_dim", "value_type": "integer", "default_aggregation": "none"},
        {"key": "pq_bits", "display_name": "pq_bits", "value_type": "integer", "default_aggregation": "none"},
        {"key": "internalDistanceDtype", "display_name": "internalDistanceDtype", "value_type": "string"},
        {"key": "smemLutDtype", "display_name": "smemLutDtype", "value_type": "string"},
        {"key": "refine_ratio", "display_name": "refine_ratio", "value_type": "integer", "default_aggregation": "none"}
      ]
    },
    {
      "query_name": "cuvs_ivf_flat",
      "extra_info": {"algorithm": "IVF-Flat", "index_type": "ivf"},
      "metrics": []
    },
    {
      "query_name": "cuvs_brute_force",
      "extra_info": {"algorithm": "Brute Force", "index_type": "exact"},
      "metrics": []
    }
  ]
}
